  "color": "cyan",
  "tools": [
    "skill_list",
    "skill_load",
    "delegate",
    "reply",
    "question",
    "todowrite",
    "log"
  ],
  "skills": [
    "requirements",
    "session-management",
    "code-exploration",
    "agent-eval",
    "skill-eval",
    "tool-eval",
    "session-eval",
    "retro",
    "agent-experiment",
    "project-requirements",
    "agent-author",
    "skill-author",
    "skill-creator",
    "tool-curator",
    "suno-auth-exploration",
    "agent-ops"
  ],
  "toolConfig": {
    "delegate": {
      "allowedAgents": [
        "Product Owner",
        "Weber",
        "Product Engineer",
        "Minds"
      ]
    },
    "reply": {
      "stopAfterReply": false
    }
  },
  "enableInjection": false,
  "defaultPaths": [
    "/home/mariu/projects/opendora/.opendora"
  ]
}