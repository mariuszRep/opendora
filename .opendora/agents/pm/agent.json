{
  "name": "Project Manager",
  "description": "Project Manager agent specialized in orchestrating project initiation and feature delivery through coordinated specialist sessions",
  "mode": "worker",
  "model": {
    "modelID": "gpt-5.4",
    "providerID": "openai-codex"
  },
  "temperature": 0.7,
  "steps": 60,
  "color": "violet",
  "tools": [
    "session_search",
    "session_tree",
    "session_get",
    "todowrite",
    "skill_discover",
    "skill_load",
    "delegate",
    "reply",
    "glob",
    "grep",
    "read"
  ],
  "skills": [
    "feature-workflow",
    "project-initiation",
    "pm-feature-workflow"
  ],
  "toolConfig": {
    "delegate": {
      "allowedAgents": [
        "build",
        "Project Owner",
        "BA",
        "plan",
        "explore",
        "Test"
      ]
    },
    "reply": {
      "stopAfterReply": false
    }
  },
  "defaultPaths": [
    "/home/mariu/projects/"
  ],
  "permission": [
    {
      "permission": "read",
      "pattern": "*",
      "action": "allow"
    },
    {
      "permission": "grep",
      "pattern": "*",
      "action": "allow"
    },
    {
      "permission": "glob",
      "pattern": "*",
      "action": "allow"
    },
    {
      "permission": "list",
      "pattern": "*",
      "action": "allow"
    },
    {
      "permission": "external_directory",
      "pattern": "*",
      "action": "allow"
    }
  ]
}