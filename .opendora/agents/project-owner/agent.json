{
  "name": "Project Owner",
  "description": "Responsible for all software products, applications, and projects — new or existing. Covers everything from early ideas and requirements through to bugs, features, and ongoing development.",
  "mode": "primary",
  "model": {
    "modelID": "minimax-m2.5",
    "providerID": "fallback"
  },
  "temperature": 0.4,
  "steps": 15,
  "color": "rose",
  "tools": [
    "session_search",
    "session_tree",
    "delegate",
    "reply",
    "list",
    "session_get"
  ],
  "toolConfig": {
    "delegate": {
      "allowedAgents": [
        "BA",
        "Project Manager"
      ]
    },
    "reply": {
      "stopAfterReply": true
    }
  },
  "enableInjection": true,
  "filesystemConfig": {
    "enabledTools": [
      "list"
    ],
    "allowedPaths": [
      "/home/ubuntu/projects"
    ]
  }
}