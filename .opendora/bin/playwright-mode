#!/usr/bin/env bash
# Switch the Playwright MCP browser between headless and headed mode.
# Usage: playwright-mode headed|headless
#
# Disconnects the playwright MCP, updates config via the API (invalidates
# the server cache), then reconnects with the new mode.

set -euo pipefail

MODE="${1:-}"
if [[ "$MODE" != "headed" && "$MODE" != "headless" ]]; then
  echo "Usage: playwright-mode headed|headless" >&2
  exit 1
fi

API="${OPENCODE_URL:-http://localhost:4097}"

BASE_CMD='["node","packages/opencode/node_modules/@playwright/mcp/cli.js"]'
HEADLESS_CMD='["node","packages/opencode/node_modules/@playwright/mcp/cli.js","--headless"]'

if [[ "$MODE" == "headless" ]]; then
  CMD="$HEADLESS_CMD"
else
  CMD="$BASE_CMD"
fi

echo "playwright-mode: switching to $MODE"

# 1. Disconnect — closes MCP client and kills the browser process
curl -sf -X POST "$API/mcp/playwright/disconnect" > /dev/null
echo "  disconnected"

# 2. Update config via API — writes to disk and invalidates the server cache
curl -sf -X PATCH "$API/config" \
  -H "Content-Type: application/json" \
  -d "{\"mcp\":{\"playwright\":{\"type\":\"local\",\"command\":$CMD}}}" > /dev/null
echo "  config updated"

# 3. Reconnect — reads fresh config and spawns the browser with the new flag
curl -sf -X POST "$API/mcp/playwright/connect" > /dev/null
echo "  connected"

echo "playwright-mode: ready ($MODE)"
