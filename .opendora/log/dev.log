from pathlib import Path
from zipfile import ZipFile
from openpyxl import load_workbook
from pypdf import PdfReader
import csv

base = Path('/home/mariu/projects/opendora/office_stress_test')
checks = []

csv_path = base / 'office_test_data.csv'
with csv_path.open() as f:
    rows = list(csv.reader(f))
checks.append(('CSV rows', len(rows) == 5, len(rows)))

xlsx_path = base / 'office_test_workbook.xlsx'
wb = load_workbook(xlsx_path, data_only=False)
checks.append(('XLSX sheet', wb.sheetnames == ['Smoke Test'], wb.sheetnames))
checks.append(('XLSX formula', wb['Smoke Test']['B6'].value == '=AVERAGE(B2:B5)', wb['Smoke Test']['B6'].value))

for filename, required in [
    ('office_test_document.docx', ['[Content_Types].xml', 'word/document.xml']),
    ('office_test_presentation.pptx', ['[Content_Types].xml', 'ppt/presentation.xml', 'ppt/slides/slide1.xml']),
]:
    p = base / filename
    with ZipFile(p) as z:
        names = set(z.namelist())
    checks.append((filename + ' package', all(r in names for r in required), sorted(required)))

for p in [base / 'office_test_pdf.pdf', *(base / 'converted_pdf').glob('*.pdf')]:
    reader = PdfReader(str(p))
    checks.append((p.name + ' pages', len(reader.pages) >= 1, len(reader.pages)))

for name, ok, detail in checks:
    print(f'{"PASS" if ok else "FAIL"}: {name} -> {detail}')
assert all(ok for _, ok, _ in checks)
PY action={"permission":"*","pattern":"*","action":"allow"} evaluated
