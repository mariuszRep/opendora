from pathlib import Path
from openpyxl import Workbook, load_workbook
from openpyxl.styles import Font, PatternFill, Alignment
from openpyxl.utils import get_column_letter

out = Path('/home/mariu/projects/opendora/simple_budget.xlsx')
wb = Workbook()
ws = wb.active
ws.title = 'Simple Budget'

rows = [
    ['Item', 'Category', 'Amount'],
    ['Rent', 'Housing', 1200],
    ['Groceries', 'Food', 300],
    ['Transport', 'Travel', 120],
    ['Phone', 'Utilities', 45],
    ['Total', '', '=SUM(C2:C5)'],
]

for row in rows:
    ws.append(row)

header_fill = PatternFill('solid', fgColor='D9EAF7')
for cell in ws[1]:
    cell.font = Font(bold=True)
    cell.fill = header_fill
    cell.alignment = Alignment(horizontal='center')

ws['A6'].font = Font(bold=True)
ws['C6'].font = Font(bold=True)
for row in range(2, 7):
    ws[f'C{row}'].number_format = '$#,##0'

for col in range(1, 4):
    ws.column_dimensions[get_column_letter(col)].width = 16

ws.freeze_panes = 'A2'
wb.save(out)

loaded = load_workbook(out, data_only=False)
assert loaded.sheetnames == ['Simple Budget']
assert loaded['Simple Budget']['C6'].value == '=SUM(C2:C5)'
print(out)
PY action={"permission":"*","pattern":"*","action":"allow"} evaluated
