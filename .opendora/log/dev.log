from pathlib import Path
from reportlab.lib.pagesizes import letter
from reportlab.pdfgen import canvas
from pypdf import PdfReader

out = Path('/home/mariu/projects/opendora/office_stress_test/office_test_pdf.pdf')
c = canvas.Canvas(str(out), pagesize=letter)
width, height = letter
c.setFont('Helvetica-Bold', 18)
c.drawString(72, height - 72, 'Office Skill Smoke Test')
c.setFont('Helvetica', 11)
c.drawString(72, height - 105, 'Generated PDF artifact for PDF processing validation.')
c.drawString(72, height - 125, 'This verifies PDF creation and page-count inspection.')
c.showPage()
c.save()
reader = PdfReader(str(out))
assert len(reader.pages) == 1
text = reader.pages[0].extract_text() or ''
assert 'Office Skill Smoke Test' in text
print(out)
print('pages=1')
