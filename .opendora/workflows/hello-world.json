{
  "id": "hello-world",
  "name": "Hello World",
  "description": "Minimal test: receives a message, loads the echo skill, agent processes and responds.",
  "version": "1.0.0",
  "nodes": [
    {
      "id": "start",
      "type": "input",
      "data": {
        "type": "input",
        "fields": [{ "name": "message", "type": "string", "required": true }]
      },
      "position": { "x": 250, "y": 0 }
    },
    {
      "id": "load-echo",
      "type": "skill_load",
      "data": { "type": "skill_load", "skill": "echo" },
      "position": { "x": 250, "y": 140 }
    },
    {
      "id": "process",
      "type": "agent",
      "data": {
        "type": "agent",
        "prompt": "Echo the following message back to the user: $input.message",
        "output": "result"
      },
      "position": { "x": 250, "y": 280 }
    },
    {
      "id": "done",
      "type": "output",
      "data": { "type": "output", "message": "Workflow complete. Result: $ctx.result" },
      "position": { "x": 250, "y": 420 }
    }
  ],
  "edges": [
    { "id": "e1", "source": "start", "target": "load-echo" },
    { "id": "e2", "source": "load-echo", "target": "process" },
    { "id": "e3", "source": "process", "target": "done" }
  ]
}
