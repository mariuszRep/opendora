{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default desktop capabilities: shell sidecar, tray, navigate to localhost",
  "platforms": ["windows", "macOS", "linux"],
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-close",
    "core:window:allow-set-focus",
    "shell:allow-execute",
    "shell:allow-open",
    "shell:allow-stdin-write",
    "shell:allow-kill"
  ]
}
