{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opendora",
  "description": "OpenDora - AI-powered development API",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.10",
  "scripts": {
    "dev": "OPENCODE_PROJECT_ROOT=$PWD OPENCODE_CONFIG_DIR=$PWD/.opendora bun run packages/opencode/src/index.ts",
    "tui": "OPENCODE_PROJECT_ROOT=$PWD OPENCODE_CONFIG_DIR=$PWD/.opendora bun run packages/opencode/src/index.ts attach http://localhost:4097",
    "serve": "LD_PRELOAD=$PWD/packages/tools/desktop/x11_nocrash.so OPENCODE_PROJECT_ROOT=$PWD OPENCODE_CONFIG_DIR=$PWD/.opendora bun run packages/opencode/src/index.ts serve --port 4097",
    "start": "OPENCODE_PROJECT_ROOT=$PWD OPENCODE_CONFIG_DIR=$PWD/.opendora bun run packages/opencode/src/index.ts start",
    "stop": "OPENCODE_PROJECT_ROOT=$PWD OPENCODE_CONFIG_DIR=$PWD/.opendora bun run packages/opencode/src/index.ts stop",
    "restart": "OPENCODE_PROJECT_ROOT=$PWD OPENCODE_CONFIG_DIR=$PWD/.opendora bun run packages/opencode/src/index.ts restart",
    "status": "OPENCODE_PROJECT_ROOT=$PWD OPENCODE_CONFIG_DIR=$PWD/.opendora bun run packages/opencode/src/index.ts status",
    "dev:ui": "bash ./scripts/dev-ui.sh",
    "typecheck": "bun turbo typecheck",
    "test": "echo 'do not run tests from root' && exit 1"
  },
  "workspaces": {
    "packages": [
      "packages/agent",
      "packages/permission",
      "packages/script",
      "packages/tools",
      "packages/opencode",
      "packages/provider",
      "packages/sdk/js",
      "packages/util",
      "ui/*",
      "packages/session",
      "packages/schedule",
      "packages/workflow"
    ],
    "catalog": {
      "@types/bun": "1.3.9",
      "@octokit/rest": "22.0.0",
      "@hono/zod-validator": "0.4.2",
      "ulid": "3.0.1",
      "@types/luxon": "3.7.1",
      "@types/node": "22.13.9",
      "@types/semver": "7.7.1",
      "@tsconfig/node22": "22.0.2",
      "@tsconfig/bun": "1.0.9",
      "@cloudflare/workers-types": "4.20251008.0",
      "@openauthjs/openauth": "0.0.0-20250322224806",
      "@pierre/diffs": "1.1.0-beta.13",
      "diff": "8.0.2",
      "drizzle-kit": "1.0.0-beta.12-a5629fb",
      "drizzle-orm": "1.0.0-beta.12-a5629fb",
      "ai": "5.0.124",
      "hono": "4.10.7",
      "hono-openapi": "1.1.2",
      "fuzzysort": "3.1.0",
      "luxon": "3.6.1",
      "marked": "17.0.1",
      "marked-shiki": "1.2.1",
      "typescript": "5.8.2",
      "@typescript/native-preview": "7.0.0-dev.20251207.1",
      "zod": "4.1.8",
      "remeda": "2.26.0",
      "shiki": "3.20.0",
      "solid-js": "1.9.10",
      "@types/react": "19.0.0",
      "@types/react-dom": "19.0.0"
    }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.2",
    "@tsconfig/bun": "catalog:",
    "@types/mime-types": "3.0.1",
    "concurrently": "^9.1.2",
    "glob": "13.0.5",
    "prettier": "3.6.2",
    "semver": "^7.6.0",
    "shadcn": "4.1.0",
    "tailwindcss": "4.2.2",
    "turbo": "2.5.6",
    "tw-animate-css": "1.4.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.933.0",
    "@opencode-ai/plugin": "*",
    "@opendora/sdk": "workspace:*",
    "@opendora/util": "workspace:*",
    "@pdf-lib/fontkit": "1.1.1",
    "pdf-lib": "1.17.1",
    "quansync": "1.0.0",
    "react": "19.2.5",
    "typescript": "catalog:",
    "xlsx": "0.18.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/opendora"
  },
  "license": "MIT",
  "prettier": {
    "semi": false,
    "printWidth": 120
  },
  "trustedDependencies": [
    "esbuild",
    "protobufjs",
    "tree-sitter",
    "tree-sitter-bash",
    "web-tree-sitter"
  ],
  "overrides": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:"
  }
}
