{
  "name": "desktop_mouse_drag",
  "description": "Press and hold a mouse button at `from`, drag to `to`, then release.\n\n`button` defaults to \"left\". `speed` controls pixels per second (default: 1000).",
  "inputSchema": {
    "type": "object",
    "properties": {
      "from": {
        "type": "object",
        "properties": { "x": { "type": "number" }, "y": { "type": "number" } },
        "required": ["x", "y"],
        "description": "Start position {x, y}"
      },
      "to": {
        "type": "object",
        "properties": { "x": { "type": "number" }, "y": { "type": "number" } },
        "required": ["x", "y"],
        "description": "End position {x, y}"
      },
      "button": { "type": "string", "enum": ["left", "right", "middle"], "description": "Mouse button to hold during drag (default: left)" },
      "speed": { "type": "number", "description": "Mouse speed in pixels/sec" }
    },
    "required": ["from", "to"]
  }
}
