    "./communication/*": "./communication/*.ts",
    "./system/*": "./system/*.ts",
    "./filesystem": "./filesystem/index.ts",
    "./filesystem/*": "./filesystem/*.ts",
    "./filesystem/lib/*": "./filesystem/lib/*.ts",
    "./agent-manager": "./agent-manager/index.ts",
    "./system": "./system/index.ts",
    "./tool-registry": "./tool-registry/index.ts",
    "./communication": "./communication/index.ts",
    "./sessions": "./sessions/index.ts",
    "./execution": "./execution/index.ts",
    "./browser": "./browser/index.ts",
    "./browse-and-web": "./browse-and-web/index.ts",
    "./browse-and-web/*": "./browse-and-web/*.ts",
    "./schedule": "./schedule/index.ts",
    "./schedule/*": "./schedule/*.ts",
    "./desktop": "./desktop/index.ts",
