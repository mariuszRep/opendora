{
  "$schema": "https://json.schemastore.org/package.json",
  "version": "1.0.0",
  "name": "@opendora/tools",
  "type": "module",
  "license": "MIT",
  "private": true,
  "scripts": {
    "typecheck": "tsgo --noEmit",
