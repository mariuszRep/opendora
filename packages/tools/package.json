    "glob": "13.0.5",
    "ignore": "7.0.5",
    "mime-types": "3.0.2",
    "minimatch": "10.0.3",
    "playwright-core": "1.59.1",
    "tree-sitter-bash": "0.25.0",
    "turndown": "7.2.0",
    "web-tree-sitter": "0.25.10",
    "zod": "catalog:",
