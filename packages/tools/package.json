{
  "$schema": "https://json.schemastore.org/package.json",
  "version": "1.0.0",
  "name": "@projectflows/tools",
  "type": "module",
  "license": "MIT",
  "private": true,
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "test": "bun test --timeout 30000",
    "generate-tool-json": "bun scripts/generate-tool-json.ts"
  },
  "exports": {
    "./system": "./system/index.ts",
    "./system/*": "./system/*.ts",
    "./filesystem": "./filesystem/index.ts",
    "./filesystem/*": "./filesystem/*.ts",
    "./filesystem/lib/*": "./filesystem/lib/*.ts",
    "./file": "./file/index.ts",
    "./file/watcher": "./file/watcher.ts",
    "./file/time": "./file/time.ts",
    "./tool": "./tool.ts",
    "./group-manifest": "./group-manifest.ts",
    "./registry": "./registry.ts",
    "./truncation": "./truncation.ts",
    "./truncation-impl": "./truncation-impl.ts",
    "./skill-load-tool": "./skill-load-tool.ts",
    "./memory/lib": "./memory/lib.ts",
    "./delegation/*": "./delegation/*.ts",
    "./workflow-delegation/*": "./workflow-delegation/*.ts",
    "./sessions/*": "./sessions/*.ts"
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native-preview": "catalog:",
    "@types/turndown": "5.0.5",
    "@projectflows/skills": "workspace:*",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@projectflows/agent": "workspace:*",
    "@projectflows/config": "workspace:*",
    "@projectflows/permission": "workspace:*",
    "@projectflows/runtime": "workspace:*",
    "@projectflows/session": "workspace:*",
    "@projectflows/util": "workspace:*",
    "@projectflows/workflow": "workspace:*",
    "@zip.js/zip.js": "2.7.62",
    "diff": "catalog:",
    "fuzzysort": "3.1.0",
    "glob": "13.0.5",
    "ignore": "7.0.5",
    "mime-types": "3.0.2",
    "minimatch": "10.0.3",
    "tree-sitter-bash": "0.25.0",
    "turndown": "7.2.0",
    "web-tree-sitter": "0.25.10",
    "zod": "catalog:",
    "zod-to-json-schema": "3.25.2",
    "hono": "catalog:"
  }
}
