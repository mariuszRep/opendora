{
  "name": "pyautogui_mouse_drag_relative",
  "description": "Drag the mouse by a relative offset (dx, dy) from its current position with the button held down.\n\nReturns the final cursor position.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "dx": { "type": "integer", "description": "Horizontal offset in pixels" },
      "dy": { "type": "integer", "description": "Vertical offset in pixels" },
      "button": { "type": "string", "enum": ["left", "right", "middle"], "description": "Mouse button to hold (default: left)" },
      "duration": { "type": "number", "description": "Drag duration in seconds (default: 0.4)" }
    },
    "required": ["dx", "dy"]
  }
}
