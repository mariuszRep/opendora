{
  "name": "skill_search",
  "description": "Search for skills across multiple registries (ClawHub, GitHub, Vercel, Anthropic). Use this to discover new skills that can extend the agent's capabilities.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "description": "Search query for finding skills"
      },
      "registries": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": ["clawhub", "github", "vercel", "anthropic"]
        },
        "description": "Specific registries to search (default: all)"
      }
    },
    "required": ["query"]
  }
}
